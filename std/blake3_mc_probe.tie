type tie<logic>
// std/blake3_mc_probe.tie —— blake3 多 chunk 树形官方 KAT（期望值由官方 blake3 Python 模块生成）
// 背景：多 chunk finalize 曾把「末 chunk」也做完成合并+入栈（多合并一次 parent(cv,cv)），
// 单 chunk 向量与新旧实现自洽检查均无法暴露；本探针以官方向量钉死树形路径（含幂边界与深栈）。
// 输入模式：pattern(i) = (i*7+3) & 0xFF；空串/abc 为官方标准向量。
// 每项 PASS 打 `b3mc:<name>:OK`；全部 PASS 打印 `b3mc:ALL:PASS` 且 exit 0。

import "./blake3.tie" as b3

var g_rc: i64 = 0

func expect(cond: bool, name: string) {
    if !cond {
        println("b3mc:" + name + ":FAIL")
        g_rc = 1
    } else {
        println("b3mc:" + name + ":OK")
    }
}

func pat_s(n: i64) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < n {
        sb_append_byte(sb, (i * 7 + 3) & 0xFF)
        i = i + 1
    }
    return sb_build(sb)
}

func main() -> i64 {
    expect(b3.blake3_256("") == "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262", "single_empty")
    expect(b3.blake3_256("abc") == "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85", "single_abc")
    expect(b3.blake3_256(pat_s(1023)) == "b16a55436c00d72a5bbdeae4b0cfb08c88a9cf5aad4de867a4fd0f4526afa8c7", "mc_1023")
    expect(b3.blake3_256(pat_s(1024)) == "e3f027f2c0380f4ee59b4213e5bbfc65e5158b27196bb5ea63453a2cbc47a888", "mc_1024_boundary")
    expect(b3.blake3_256(pat_s(1025)) == "afd7cf3dec77579ce5aaab21256350d354ca4caaef56e897405771d6bb4c0c93", "mc_1025_two_chunks")
    expect(b3.blake3_256(pat_s(2048)) == "c29fc14369d8d5eb92f6d336fc25e6b63f19581bdaf85e2f9fad596471ff7b85", "mc_2048_exact_two")
    expect(b3.blake3_256(pat_s(3000)) == "2285e439b7e4f97ba8ffddd68f8aff06a8ba2edbe908e0ef3aee03c002971afe", "mc_3000_three_chunks")
    expect(b3.blake3_256(pat_s(4096)) == "9e3a7ccd40e77a7060d87c025e1a98d250a2911c7c3e5c2f0d99f1232701750e", "mc_4096_exact_four")
    expect(b3.blake3_256(pat_s(7000)) == "d904b4e7c31977e92e4f60632ca66f9bd6b78a0c554e253f3ea2b84a0ed757a7", "mc_7000_seven_chunks")
    expect(b3.blake3_256(pat_s(9000)) == "b5268563bdc68a0223223ba6a8094f2a38993f65dd35a55db26236d8b5712e53", "mc_9000_nine_chunks")
    if g_rc == 0 {
        println("b3mc:ALL:PASS")
    } else {
        println("b3mc:ALL:FAIL")
    }
    return g_rc
}
