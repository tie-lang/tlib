type tie<logic>
// std/tink_aead_probe.tie —— tink v3 安全接线探针（设计文档 §6.3/§6.4/§6.5 验收）
// A. 原语 KAT（RFC 8439 全向量）：块函数 §2.3.2 / 流加密 §2.4.2 / Poly1305 §2.5.2 /
//    AEAD §2.8.2；篡改 ct/tag/错钥/错 AAD 拒绝；seal→open 往返。
// B. 协议层：AEAD 密钥派生 KAT（Python 独立推演值）；重钥 KAT 与换钥隔离；
//    帧密封/开启往返；AAD 绑定头与扩展区；方向/纪元/计数器区分性；
//    抗重放滑窗（重复/过界/推进）；密封批接线（开→拆批）。
// 每项 PASS 打 `tinkv3s:<name>:OK`；失败 `tinkv3s:<name>:FAIL` 并把返回码置 1。
// 全部 PASS 打印 `tinkv3s:ALL:PASS` 且 exit 0。

import "./tink.tie" as t3
import "./chacha20.tie" as chacha20
import "./poly1305.tie" as poly
import "./bytes.tie" as bytes

var g_rc: i64 = 0

func expect(cond: bool, name: string) {
    if !cond {
        println("tinkv3s:" + name + ":FAIL")
        g_rc = 1
    } else {
        println("tinkv3s:" + name + ":OK")
    }
}

func ascii(s: string) -> table<i64> {
    var o = table_new_i64()
    var i: i64 = 0
    while i < str_len(s) {
        table_push(o, char_code(str_char(s, i)) & 0xFF)
        i = i + 1
    }
    return o
}

func main() -> i64 {
    var empty = table_new_i64()
    var crc = t3.fl_crc()

    // ---- KAT 常量（RFC 8439 原文 + Python 独立推演） ----
    var K1 = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    var N1 = "000000090000004a00000000"
    var KS1 = "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e"
    var N2 = "000000000000004a00000000"
    var CT2 = "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d"
    var PK1 = "85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b"
    var PTAG = "a8061dc1305136c6c22b8baf0c0127a9"
    var K2 = "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
    var N3 = "070000004041424344454647"
    var AAD = "50515253c0c1c2c3c4c5c6c7"
    var AEADCT = "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116"
    var AETAG = "1ae10b594f09e26a7e902ecbd0600691"
    var SUN = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
    var CAP = "a79f4e926e49cc7092346638f5ffc4c7f5355fbd5daceb6104c76e9e828a319e"
    var AKEY = "0973af3e5226b2317a9aafa2b8f1520c22ab57d3ad0e0ef27b2225e1ad5b6c6b"
    var KUNX = "6b6ffc553da929a237621d85ca3ab0124c85b6149016b8dc4a26b4e519682a85"
    var ptx = ascii(SUN)
    expect(len(ptx) == 114, "pt_len_114")

    // ---- A1 块函数 §2.3.2 ----
    expect(bytes.to_hex(chacha20.block(K1, N1, 1)) == KS1, "block_kat")

    // ---- A2 流加密 §2.4.2 ----
    expect(bytes.to_hex(chacha20.xor_stream(K1, N2, 1, ptx)) == CT2, "cipher_kat")

    // ---- A3 Poly1305 §2.5.2 ----
    expect(poly.poly1305(PK1, "Cryptographic Forum Research Group") == PTAG, "poly_kat")

    // ---- A4 AEAD §2.8.2 ----
    var aadx = bytes.from_hex(AAD)
    var seal1 = chacha20.aead_seal(K2, N3, aadx, ptx)
    expect(bytes.to_hex(seal1) == AEADCT + AETAG, "aead_kat")
    var (o1, p1) = chacha20.aead_open(K2, N3, aadx, seal1)
    expect(o1 == 1 && bytes.to_hex(p1) == bytes.to_hex(ptx), "aead_roundtrip")
    var badct = bytes.slice(seal1, 0, len(seal1))
    badct[3] = (badct[3] ^ 0x01) & 0xFF
    var (o2, p2) = chacha20.aead_open(K2, N3, aadx, badct)
    expect(o2 == 0, "aead_tamper_ct")
    var badtag = bytes.slice(seal1, 0, len(seal1))
    badtag[len(badtag) - 1] = (badtag[len(badtag) - 1] ^ 0x80) & 0xFF
    var (o3, p3) = chacha20.aead_open(K2, N3, aadx, badtag)
    expect(o3 == 0, "aead_tamper_tag")
    var (o4, p4) = chacha20.aead_open(K1, N3, aadx, seal1)
    expect(o4 == 0, "aead_wrong_key")
    var (o5, p5) = chacha20.aead_open(K2, N3, bytes.from_hex("50515253c0c1c2c3c4c5c6c8"), seal1)
    expect(o5 == 0, "aead_wrong_aad")

    // ---- B1 密钥派生 KAT ----
    expect(t3.hs_aead_key(CAP) == AKEY && len(AKEY) == 64, "aead_key_kat")
    expect(t3.ku_next(CAP) == KUNX, "ku_kat")
    var kuf = t3.key_update_frame(0, 9, 1, crc)
    var (k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10) = t3.frame_view(kuf, 0)
    expect(k0 == 1 && k1 == t3.ft_key_update() && kuf[k5] == 1, "key_update_frame")

    // ---- B2 帧密封/开启 ----
    var fk = AKEY
    var ext = t3.ext_tlv_u8(t3.tlv_priority(), 5)
    var fs = t3.frame_seal(t3.ft_message(), t3.fl_ext(), 1, 7, ptx, ext, fk, 0, 0, 0)
    var (s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10) = t3.frame_view(fs, 0)
    expect(s0 == 1 && (s2 & 2) != 0 && s9 == -1 && len(fs) == 16 + 2 + len(ext) + len(ptx) + 16, "seal_frame_layout")
    var (o6, p6, n6) = t3.frame_open(fs, 0, fk, 0, 0, 0)
    expect(o6 == 1 && bytes.to_hex(p6) == bytes.to_hex(ptx) && n6 == len(fs), "seal_open_roundtrip")
    var fb = bytes.slice(fs, 0, len(fs))
    fb[12] = (fb[12] ^ 0xFF) & 0xFF
    var (o7, p7, n7) = t3.frame_open(fb, 0, fk, 0, 0, 0)
    expect(o7 == 0, "open_aad_binds_header")
    var fe = bytes.slice(fs, 0, len(fs))
    fe[s7] = (fe[s7] ^ 0x01) & 0xFF
    var (o8, p8, n8) = t3.frame_open(fe, 0, fk, 0, 0, 0)
    expect(o8 == 0, "open_aad_binds_ext")
    var (o9, p9, n9) = t3.frame_open(fs, 0, fk, 1, 0, 0)
    expect(o9 == 0, "open_wrong_dir")
    var (o10, p10, n10) = t3.frame_open(fs, 0, fk, 0, 1, 0)
    expect(o10 == 0, "open_wrong_epoch")
    var (o11, p11, n11) = t3.frame_open(fs, 0, fk, 0, 0, 1)
    expect(o11 == 0, "open_wrong_ctr")
    var plainf = t3.msg_frame(ascii("plain"), 1, 1, crc)
    var (o12, p12, n12) = t3.frame_open(plainf, 0, fk, 0, 0, 0)
    expect(o12 == -1, "open_nonprotected")

    // ---- B3 方向/纪元/计数器区分性 ----
    var g0 = bytes.to_hex(t3.frame_seal(t3.ft_message(), 0, 1, 7, ptx, empty, fk, 0, 0, 0))
    var g1 = bytes.to_hex(t3.frame_seal(t3.ft_message(), 0, 1, 7, ptx, empty, fk, 1, 0, 0))
    var g2 = bytes.to_hex(t3.frame_seal(t3.ft_message(), 0, 1, 7, ptx, empty, fk, 0, 1, 0))
    var g3 = bytes.to_hex(t3.frame_seal(t3.ft_message(), 0, 1, 7, ptx, empty, fk, 0, 0, 1))
    var g0b = bytes.to_hex(t3.frame_seal(t3.ft_message(), 0, 1, 7, ptx, empty, fk, 0, 0, 0))
    expect(g0 != g1 && g0 != g2 && g0 != g3 && g0 == g0b, "seal_nonce_domain")

    // ---- B4 换钥隔离 ----
    var fk2 = t3.hs_aead_key(KUNX)
    var fs2 = t3.frame_seal(t3.ft_message(), 0, 1, 8, ptx, empty, fk2, 0, 0, 0)
    var (o13, p13, n13) = t3.frame_open(fs2, 0, fk, 0, 0, 0)
    expect(o13 == 0, "rekey_isolates_old_key")
    var (o14, p14, n14) = t3.frame_open(fs2, 0, fk2, 0, 0, 0)
    expect(o14 == 1, "rekey_new_key_works")

    // ---- B5 抗重放滑窗 ----
    var rs = t3.rp_new()
    var r1 = t3.rp_check(rs, 5)
    var r2 = t3.rp_check(rs, 5)
    var r3 = t3.rp_check(rs, 6)
    var r4 = t3.rp_check(rs, 4)
    var r5 = t3.rp_check(rs, 7)
    var r6 = t3.rp_check(rs, 6)
    var r7 = t3.rp_check(rs, 3)
    expect(r1 == 1 && r2 == 0 && r3 == 1 && r4 == 1 && r5 == 1 && r6 == 0 && r7 == 1, "rp_basic")
    var r8 = t3.rp_check(rs, 2000)
    var r9 = t3.rp_check(rs, 2000)
    var r10 = t3.rp_check(rs, 1000)
    var r11 = t3.rp_check(rs, 979)
    var r12 = t3.rp_check(rs, 976)
    var r13 = t3.rp_check(rs, 2001)
    expect(r8 == 1 && r9 == 0 && r10 == 1 && r11 == 1 && r12 == 0 && r13 == 1, "rp_window_advance")

    // ---- B6 密封批接线 ----
    var in1 = t3.msg_frame(ascii("a1"), 1, 0, 0)
    var in2 = t3.msg_frame(ascii("b2"), 1, 1, 0)
    var inner = bytes.concat(in1, in2)
    var body = t3.batch_pack(inner)
    var sbf = t3.frame_seal(t3.ft_batch(), 0, 0, 0, body, empty, fk, 0, 0, 5)
    var (x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10) = t3.frame_view(sbf, 0)
    expect(x0 == 1 && x1 == t3.ft_batch() && (x2 & 2) != 0 && x9 == -1, "sealed_batch_struct")
    var (o15, p15, n15) = t3.frame_open(sbf, 0, fk, 0, 0, 5)
    expect(o15 == 1 && bytes.to_hex(p15) == bytes.to_hex(body), "sealed_batch_open")
    var (b1o, b1a, b1b) = t3.batch_unpack(p15, 0, len(p15))
    expect(b1o == 1 && len(b1a) == 2 && b1b[0] == len(in1), "sealed_batch_unpack")

    // ---- 收尾 ----
    if g_rc == 0 {
        println("tinkv3s:ALL:PASS")
    } else {
        println("tinkv3s:ALL:FAIL")
    }
    return g_rc
}
