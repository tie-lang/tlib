type tie<logic>
// std/tink_bus_probe.tie —— tink v3 总线探针（设计文档 §7/§4.4 验收）
// 覆盖：REGISTER/LOOKUP/LOOKUP_REPLY/SUBSCRIBE/UNSUBSCRIBE/PUBLISH/MULTICAST 编解码；
//   peer_id（algo 前缀）与条目扫描；通配匹配（精确/前缀/后缀/中缀/多星/全星/不匹配）；
//   hub 名字路由（注册/更新/注销/查询）；订阅扇出（去重 + 退订）；线格式端到端
//   （注册→发现→回执→订阅→发布→组播/逐点）。
// 每项 PASS 打 `tinkv3u:<name>:OK`；失败 `tinkv3u:<name>:FAIL` 并把返回码置 1。
// 全部 PASS 打印 `tinkv3u:ALL:PASS` 且 exit 0。

import "./tink.tie" as t3
import "./bytes.tie" as bytes

var g_rc: i64 = 0

func expect(cond: bool, name: string) {
    if !cond {
        println("tinkv3u:" + name + ":FAIL")
        g_rc = 1
    } else {
        println("tinkv3u:" + name + ":OK")
    }
}

func main() -> i64 {
    var empty = table_new_i64()
    var crc = t3.fl_crc()

    // ---- 1) REGISTER 编解码 ----
    var rf = t3.register_frame(0, 1, "svc.echo", 0x1122334455667788, crc)
    var (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10) = t3.frame_view(rf, 0)
    var (rs0, rsn, rsc) = t3.reg_scan(rf, r5, r6)
    expect(r0 == 1 && r1 == t3.ft_register() && rs0 == 1 && rsn == "svc.echo" && rsc == 0x1122334455667788, "register_codec")

    // ---- 2) LOOKUP / SUBSCRIBE / UNSUBSCRIBE 编解码 ----
    var lf = t3.lookup_frame(0, 2, "svc.echo", crc)
    var (l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10) = t3.frame_view(lf, 0)
    var (ls0, lsn) = t3.lookup_scan(lf, l5, l6)
    expect(l0 == 1 && l1 == t3.ft_lookup() && ls0 == 1 && lsn == "svc.echo", "lookup_codec")
    var sf = t3.sub_frame(0, 3, "sensors/*", crc)
    var (s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10) = t3.frame_view(sf, 0)
    var (ss0, ssp) = t3.sub_scan(sf, s5, s6)
    expect(s0 == 1 && s1 == t3.ft_subscribe() && ss0 == 1 && ssp == "sensors/*", "subscribe_codec")
    var uf = t3.unsub_frame(0, 4, "sensors/*", crc)
    var (uu0, uu1, uu2, uu3, uu4, uu5, uu6, uu7, uu8, uu9, uu10) = t3.frame_view(uf, 0)
    var (us0, usp) = t3.sub_scan(uf, uu5, uu6)
    expect(uu0 == 1 && uu1 == t3.ft_unsubscribe() && us0 == 1 && usp == "sensors/*", "unsubscribe_codec")

    // ---- 3) LOOKUP_REPLY（peer_id 带 algo 前缀 + addr） ----
    var dg1 = bytes.fill(32, 0xAA)
    var dg2 = bytes.fill(32, 0xBB)
    var pids = bytes.concat(t3.pid_make(1, dg1), t3.pid_make(3, dg2))
    var addrs: table<string> = []
    table_push(addrs, "10.0.0.1:7000")
    table_push(addrs, "10.0.0.2:7001")
    var rb = t3.reply_body(pids, addrs)
    var (rc0, rc1) = t3.reply_count(rb, 0, len(rb))
    expect(rc0 == 1 && rc1 == 2, "reply_count")
    var (e0, ea0, ead0, eal0, eaa0, eab0) = t3.reply_entry(rb, 0, len(rb), 0)
    expect(e0 == 1 && ea0 == 1 && ead0 == 4 && eal0 == 32 && bytes.to_hex(bytes.slice(rb, ead0, ead0 + 32)) == bytes.to_hex(dg1), "reply_entry0_pid")
    expect(bytes.to_hex(bytes.slice(rb, eaa0, eaa0 + eab0)) == bytes.to_hex(bytes.from_ascii("10.0.0.1:7000")), "reply_entry0_addr")
    var (e1, ea1, ead1, eal1, eaa1, eab1) = t3.reply_entry(rb, 0, len(rb), 1)
    expect(e1 == 1 && ea1 == 3 && bytes.to_hex(bytes.slice(rb, ead1, ead1 + 32)) == bytes.to_hex(dg2), "reply_entry1")
    var (e2, ea2, ead2, eal2, eaa2, eab2) = t3.reply_entry(rb, 0, len(rb), 2)
    expect(e2 == 0, "reply_entry_oob")

    // ---- 4) PUBLISH / MULTICAST ----
    var payload = bytes.from_hex("0102aabb")
    var pf = t3.publish_frame(0, 5, "sensors/temp", payload, crc)
    var (p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10) = t3.frame_view(pf, 0)
    var (ps0, pst, pso, psl) = t3.publish_scan(pf, p5, p6)
    expect(p0 == 1 && p1 == t3.ft_publish() && ps0 == 1 && pst == "sensors/temp" && bytes.to_hex(bytes.slice(pf, pso, pso + psl)) == "0102aabb", "publish_codec")
    var mf = t3.multicast_frame(0, 6, "sensors/temp", payload, crc)
    var (m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10) = t3.frame_view(mf, 0)
    var (ms0, mst, mso, msl) = t3.publish_scan(mf, m5, m6)
    expect(m0 == 1 && m1 == t3.ft_multicast() && ms0 == 1 && mst == "sensors/temp" && msl == 4, "multicast_codec")

    // ---- 5) 通配匹配 ----
    expect(t3.topic_match("sensors/temp", "sensors/temp") == 1, "match_exact")
    expect(t3.topic_match("sensors/*", "sensors/temp") == 1 && t3.topic_match("sensors/*", "sensors/a/b") == 1 && t3.topic_match("sensors/*", "sensors/") == 1, "match_prefix")
    expect(t3.topic_match("sensors/*", "sensor") == 0 && t3.topic_match("sensors/temp", "sensors/temperature") == 0, "match_miss")
    expect(t3.topic_match("*/temp", "sensors/temp") == 1 && t3.topic_match("*/temp", "sensors/hum") == 0, "match_suffix")
    expect(t3.topic_match("a*b*c", "aXbYc") == 1 && t3.topic_match("a*b*c", "aXc") == 0, "match_multi_star")
    expect(t3.topic_match("*", "anything") == 1 && t3.topic_match("*", "") == 1, "match_all")

    // ---- 6) hub 名字路由 ----
    var hnames: table<string> = []
    var hpeers: table<string> = []
    var hcaps: table<i64> = []
    expect(t3.hub_register(hnames, hpeers, hcaps, "svc.echo", "peerA", 1) == 1, "hub_reg_new")
    expect(t3.hub_register(hnames, hpeers, hcaps, "svc.echo", "peerA2", 2) == 0, "hub_reg_update")
    expect(t3.hub_register(hnames, hpeers, hcaps, "svc.time", "peerB", 5) == 1, "hub_reg_second")
    var (h0, hp0, hc0) = t3.hub_lookup(hnames, hpeers, hcaps, "svc.echo")
    expect(h0 == 1 && hp0 == "peerA2" && hc0 == 2, "hub_lookup_updated")
    var (h1, hp1, hc1) = t3.hub_lookup(hnames, hpeers, hcaps, "svc.nope")
    expect(h1 == 0 && t3.err_class_bus() == 0x0400, "hub_lookup_miss_no_route")
    expect(t3.hub_unregister(hnames, hpeers, hcaps, "svc.echo") == 1, "hub_unreg")
    var (h2, hp2, hc2) = t3.hub_lookup(hnames, hpeers, hcaps, "svc.echo")
    expect(h2 == 0, "hub_lookup_after_unreg")
    expect(t3.hub_unregister(hnames, hpeers, hcaps, "svc.echo") == 0, "hub_unreg_twice")

    // ---- 7) 订阅扇出（去重 + 退订） ----
    var pats: table<string> = []
    var sps: table<string> = []
    t3.hub_subscribe(pats, sps, "sensors/*", "s1")
    t3.hub_subscribe(pats, sps, "sensors/t*", "s1")
    t3.hub_subscribe(pats, sps, "sensors/temp", "s2")
    t3.hub_subscribe(pats, sps, "alerts/*", "s3")
    var f1 = t3.hub_fanout(pats, sps, "sensors/temp")
    expect(len(f1) == 2 && f1[0] == "s1" && f1[1] == "s2", "fanout_dedupe")
    var f2 = t3.hub_fanout(pats, sps, "alerts/hi")
    expect(len(f2) == 1 && f2[0] == "s3", "fanout_alerts")
    var f3 = t3.hub_fanout(pats, sps, "nope")
    expect(len(f3) == 0, "fanout_none")
    expect(t3.hub_unsubscribe(pats, sps, "sensors/temp", "s2") == 1, "unsub_hit")
    var f4 = t3.hub_fanout(pats, sps, "sensors/temp")
    expect(len(f4) == 1 && f4[0] == "s1", "fanout_after_unsub")
    expect(t3.hub_unsubscribe(pats, sps, "sensors/*", "sX") == 0, "unsub_miss")

    // ---- 8) 线格式端到端：注册 → 发现 → 回执 → 订阅 → 发布 → 组播/逐点 ----
    var e2names: table<string> = []
    var e2peers: table<string> = []
    var e2caps: table<i64> = []
    var regfr = t3.register_frame(0, 10, "svc.echo", 7, crc)
    var (g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10) = t3.frame_view(regfr, 0)
    var (gr0, grn, grc) = t3.reg_scan(regfr, g5, g6)
    var hret = t3.hub_register(e2names, e2peers, e2caps, grn, "peerA", grc)
    expect(gr0 == 1 && hret == 1, "e2e_register_wire")
    var lkfr = t3.lookup_frame(0, 11, "svc.echo", crc)
    var (k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10) = t3.frame_view(lkfr, 0)
    var (lk0, lkn) = t3.lookup_scan(lkfr, k5, k6)
    var (fk0, fkp, fkc) = t3.hub_lookup(e2names, e2peers, e2caps, lkn)
    var e2addrs: table<string> = []
    table_push(e2addrs, fkp)
    var repfr = t3.reply_frame(0, 12, t3.pid_make(1, bytes.fill(16, 0xDD)), e2addrs, crc)
    var (q0, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10) = t3.frame_view(repfr, 0)
    var (qq0, qq1) = t3.reply_count(repfr, q5, q6)
    var (qe0, qea, qed, qel, qaa, qal) = t3.reply_entry(repfr, q5, q6, 0)
    expect(lk0 == 1 && fk0 == 1 && qq0 == 1 && qq1 == 1 && qe0 == 1 && qea == 1 && bytes.to_hex(bytes.slice(repfr, qaa, qaa + qal)) == bytes.to_hex(bytes.from_ascii("peerA")), "e2e_lookup_reply_wire")
    var subfr = t3.sub_frame(0, 13, "sensors/*", crc)
    var (t0, t1, t2, t3w, t4, t5, t6, t7, t8, t9, t10) = t3.frame_view(subfr, 0)
    var (tsp0, tspp) = t3.sub_scan(subfr, t5, t6)
    var hsub = t3.hub_subscribe(pats, sps, tspp, "peerA")
    var pubfr = t3.publish_frame(0, 14, "sensors/temp", payload, crc)
    var (w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10) = t3.frame_view(pubfr, 0)
    var (wp0, wpt, wpo, wpl) = t3.publish_scan(pubfr, w5, w6)
    var targets = t3.hub_fanout(pats, sps, wpt)
    var outfr = t3.multicast_frame(0, 15, wpt, bytes.slice(pubfr, wpo, wpo + wpl), crc)
    var (x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10) = t3.frame_view(outfr, 0)
    var (xp0, xpt, xpo, xpl) = t3.publish_scan(outfr, x5, x6)
    expect(tsp0 == 1 && hsub == 1 && wp0 == 1 && len(targets) >= 2 && x0 == 1 && x1 == t3.ft_multicast() && xpt == "sensors/temp", "e2e_publish_fanout_multicast")
    var one: table<string> = []
    table_push(one, "peerA")
    var singlefr = t3.publish_frame(0, 16, wpt, bytes.slice(pubfr, wpo, wpo + wpl), crc)
    var (y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10) = t3.frame_view(singlefr, 0)
    expect(y0 == 1 && y1 == t3.ft_publish() && len(one) == 1, "e2e_publish_single")

    // ---- 收尾 ----
    if g_rc == 0 {
        println("tinkv3u:ALL:PASS")
    } else {
        println("tinkv3u:ALL:FAIL")
    }
    return g_rc
}
