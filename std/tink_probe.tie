type tie<logic>
// std/tink_probe.tie —— tink 帧协议 v3 帧骨架探针
// 覆盖（设计文档 §11 探针集·帧编解码）：
//   帧字段往返；全 type 往返（40 槽）；边界 len=0/65535 与超限拒绝；
//   保留位/版本/魔力早拒；未知 type 跳过策略与私有 type；扩展区（布局/空区/
//   未知 key 跳过/结构坏/缺区守卫/结构校验）；尾部互斥（编解码两侧）与保护帧
//   结构解析、裸帧；CRC32C KAT（"123456789" + RFC 3720 向量）+ 篡改检测
//   （载荷/头）；多帧行走（view/skip 成对一致）；截断 = 缓冲不足；OFFSET 载荷。
// 每项 PASS 打 `tinkv3:<name>:OK`；失败 `tinkv3:<name>:FAIL` 并把返回码置 1。
// 全部 PASS 打印 `tinkv3:ALL:PASS` 且 exit 0。

import "./tink.tie" as t3
import "./bytes.tie" as bytes
import "./time.tie" as time

// 全局返回码：任一 FAIL 置 1，最终 main 返回。
var g_rc: i64 = 0

func expect(cond: bool, name: string) {
    if !cond {
        println("tinkv3:" + name + ":FAIL")
        g_rc = 1
    } else {
        println("tinkv3:" + name + ":OK")
    }
}

// ASCII 字符串 → 字节表
func ascii(s: string) -> table<i64> {
    var o = table_new_i64()
    var i: i64 = 0
    while i < str_len(s) {
        table_push(o, char_code(str_char(s, i)))
        i = i + 1
    }
    return o
}

// 缓冲区间 [off, off+n) 与期望字节表逐字节相等（零拷贝比较）
func eqrange(b: table<i64>, off: i64, n: i64, exp: table<i64>) -> bool {
    if n != len(exp) {
        return false
    }
    var i: i64 = 0
    while i < n {
        if (b[off + i] & 0xFF) != (exp[i] & 0xFF) {
            return false
        }
        i = i + 1
    }
    return true
}

// 两字节表拼接（探针本地助手）
func cat2(a: table<i64>, b: table<i64>) -> table<i64> {
    var o = table_new_i64()
    var i: i64 = 0
    while i < len(a) {
        table_push(o, a[i])
        i = i + 1
    }
    i = 0
    while i < len(b) {
        table_push(o, b[i])
        i = i + 1
    }
    return o
}

// 模式化载荷：n 字节，第 i 字节 = (i*7+3) & 0xFF
func pat(n: i64) -> table<i64> {
    var o = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(o, (i * 7 + 3) & 0xFF)
        i = i + 1
    }
    return o
}

func main() -> i64 {
    var empty = table_new_i64()
    var p1 = pat(9)

    // ---- 1) 帧字段往返（CRC 帧，OFFSET 不置位） ----
    var f1 = t3.frame_encode(t3.ft_request(), t3.fl_crc() | t3.fl_fin(), 0xDEADBEEF, 0x00010203, p1, empty)
    var (f1ok, f1ty, f1fl, f1sd, f1sq, f1bo, f1bl, f1eo, f1el, f1io, f1nx) = t3.frame_view(f1, 0)
    expect(f1ok == 1 && f1ty == 0x40 && f1sd == 0xDEADBEEF && f1sq == 0x00010203, "fields")
    expect(f1fl == (t3.fl_crc() | t3.fl_fin()) && f1io == 1 && f1nx == len(f1), "fields_flags_iok")
    expect(f1bo == 16 && f1bl == 9 && f1el == -1 && eqrange(f1, f1bo, f1bl, p1), "fields_body")

    // ---- 2) 全 type 往返（40 个已定义槽，逐个编解码） ----
    var types = [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09,
                 0x10, 0x11, 0x12, 0x13, 0x20, 0x21, 0x22, 0x23, 0x24, 0x25,
                 0x26, 0x27, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
                 0x40, 0x41, 0x42, 0x43, 0x50, 0x51, 0x52, 0x53, 0x54, 0x60]
    var allok: bool = len(types) == 40
    var ti: i64 = 0
    while ti < 40 {
        var fr = t3.frame_encode(types[ti], t3.fl_crc(), 7, ti + 1, p1, empty)
        var (rtok, rtty, rtfl, rtsd, rtsq, rtbo, rtbl, rteo, rtel, rtio, rtnx) = t3.frame_view(fr, 0)
        if !(rtok == 1 && rtty == types[ti] && rtio == 1 && rtsq == ti + 1 && eqrange(fr, rtbo, rtbl, p1)) {
            allok = false
        }
        ti = ti + 1
    }
    expect(allok, "roundtrip_all_types")

    // ---- 3) 边界：len=0 / len=65535 / 超限拒绝 ----
    var f0 = t3.frame_encode(t3.ft_ping(), t3.fl_crc(), 0, 1, empty, empty)
    var (z0, z1, z2, z3, z4, z5, z6, z7, z8, z9, z10) = t3.frame_view(f0, 0)
    expect(len(f0) == 16 + 4 && z0 == 1 && z6 == 0 && z9 == 1 && z10 == 20, "len_zero")
    var big = pat(65535)
    var fb = t3.frame_encode(t3.ft_stream_data(), t3.fl_crc(), 3, 9, big, empty)
    var (g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10) = t3.frame_view(fb, 0)
    expect(g0 == 1 && g6 == 65535 && g9 == 1 && len(fb) == 16 + 65535 + 4, "len_max")
    expect(len(t3.frame_encode(t3.ft_message(), t3.fl_crc(), 0, 1, pat(65536), empty)) == 0, "len_overflow_reject")

    // ---- 4) 扩展区 ----
    // 4a) 布局：CONN_ID u64 + PRIORITY u8 + TOPIC bytes
    var topic = ascii("sensors/temp")
    var ex1 = cat2(cat2(t3.ext_tlv_u64(t3.tlv_conn_id(), 0x1122334455667788), t3.ext_tlv_u8(t3.tlv_priority(), 5)), t3.ext_tlv(t3.tlv_topic(), topic))
    var fe = t3.frame_encode(t3.ft_message(), t3.fl_crc() | t3.fl_ext(), 2, 4, p1, ex1)
    var (okE, tyE, flE, sdE, sqE, boE, blE, eoE, elE, ioE, nxE) = t3.frame_view(fe, 0)
    expect(okE == 1 && elE == len(ex1) && boE == 16 + 2 + len(ex1) && eqrange(fe, boE, blE, p1), "ext_layout")
    expect(t3.ext_u64(fe, eoE, elE, t3.tlv_conn_id()) == 0x1122334455667788, "ext_conn_id")
    expect(t3.ext_u8(fe, eoE, elE, t3.tlv_priority()) == 5, "ext_priority")
    var (ts1, tv1, tl1) = t3.ext_find(fe, eoE, elE, t3.tlv_topic())
    expect(ts1 == 1 && tl1 == len(topic) && eqrange(fe, tv1, tl1, topic), "ext_topic")
    expect(t3.ext_u32(fe, eoE, elE, t3.tlv_deadline()) == -1, "ext_missing")
    expect(t3.ext_check(fe, eoE, elE) == 1, "ext_check_ok")
    // 4b) 缺区守卫：无扩展区帧上调用 ext 助手 → 结构坏哨兵（-1）
    var (ns1, nv1, nl1) = t3.ext_find(f1, f1eo, f1el, t3.tlv_conn_id())
    expect(ns1 == -1, "ext_none_guard")
    // 4c) 空扩展区（EXT 置位 + ext_len=0）
    var fee = t3.frame_encode(t3.ft_message(), t3.fl_ext() | t3.fl_crc(), 2, 4, p1, empty)
    var (okF, tyF, flF, sdF, sqF, boF, blF, eoF, elF, ioF, nxF) = t3.frame_view(fee, 0)
    expect(okF == 1 && elF == 0 && eoF == 18 && boF == 18 && ioF == 1 && t3.ext_check(fee, eoF, elF) == 1, "ext_empty")
    // 4d) 未知 key 跳过（未定义 key 在前、已知 key 在后仍读出）
    var ex2 = cat2(t3.ext_tlv(1234, pat(6)), t3.ext_tlv_u8(t3.tlv_priority(), 7))
    var fu = t3.frame_encode(t3.ft_message(), t3.fl_ext() | t3.fl_crc(), 1, 2, ascii("x"), ex2)
    var (okU, tyU, flU, sdU, sqU, boU, blU, eoU, elU, ioU, nxU) = t3.frame_view(fu, 0)
    expect(okU == 1 && ioU == 1 && t3.ext_u8(fu, eoU, elU, t3.tlv_priority()) == 7, "ext_unknown_skip")
    var (ab1, ab2, ab3) = t3.ext_find(fu, eoU, elU, 999)
    expect(ab1 == 0, "ext_absent_key")
    // 4e) 结构坏：TLV 越界（vl 超出区界）与残余字节
    var bad1 = cat2(cat2(bytes.to_u16_be(1), bytes.to_u16_be(8)), pat(4))
    var (bd1, bd2, bd3) = t3.ext_find(bad1, 0, len(bad1), 1)
    expect(bd1 == -1 && t3.ext_check(bad1, 0, len(bad1)) == -1, "ext_malformed_overrun")
    var bad2 = cat2(t3.ext_tlv_u8(2, 9), bytes.to_u16_be(0))
    var (bd4, bd5, bd6) = t3.ext_find(bad2, 0, len(bad2), 2)
    expect(bd4 == -1 && t3.ext_check(bad2, 0, len(bad2)) == -1, "ext_malformed_residual")
    expect(t3.ext_u8(bad2, 0, len(bad2), 2) == -1, "ext_strict_found_malformed")
    // 4f) EXT 位与扩展区不一致 → 编码拒绝
    expect(len(t3.frame_encode(t3.ft_message(), t3.fl_crc(), 0, 1, p1, ex2)) == 0, "ext_bit_mismatch_reject")

    // ---- 5) 保留位 / 版本 / 魔力 早拒 ----
    var rbh = t3.header_encode(t3.ft_message(), 0x40, 0, 1, 0)
    var rbf = cat2(rbh, bytes.to_u32_be(0))
    var (r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10) = t3.frame_view(rbf, 0)
    expect(r0 == -1, "reserved_bits_reject")
    expect(len(t3.frame_encode(t3.ft_message(), 0x40, 0, 1, empty, empty)) == 0, "reserved_bits_encode_reject")
    var bvh = t3.header_encode(t3.ft_message(), 0, 0, 1, 0)
    bvh[2] = 2
    var (v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v210) = t3.frame_view(cat2(bvh, bytes.to_u32_be(0)), 0)
    expect(v20 == -1, "version_reject_v2")
    bvh[2] = 4
    var (v40, v41, v42, v43, v44, v45, v46, v47, v48, v49, v410) = t3.frame_view(cat2(bvh, bytes.to_u32_be(0)), 0)
    expect(v40 == -1, "version_reject_v4")
    var bgh = t3.header_encode(t3.ft_message(), 0, 0, 1, 0)
    bgh[0] = 0x73
    var (m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10) = t3.frame_view(cat2(bgh, bytes.to_u32_be(0)), 0)
    expect(m0 == -1, "magic_reject")

    // ---- 6) 未知 type 策略 / 私有 type ----
    var unh = t3.header_encode(0x0E, t3.fl_crc(), 5, 6, len(p1))
    var unbody = cat2(unh, p1)
    var unc = t3.crc32c_range(unbody, 0, len(unbody))
    var unf = cat2(unbody, bytes.to_u32_be(unc))
    var (nu0, nu1, nu2, nu3, nu4, nu5, nu6, nu7, nu8, nu9, nu10) = t3.frame_view(unf, 0)
    expect(nu0 == 1 && nu1 == 0x0E && nu9 == 1 && nu10 == len(unf), "unknown_type_skipable")
    expect(len(t3.frame_encode(0x0E, t3.fl_crc(), 0, 1, empty, empty)) == 0, "unknown_type_encode_reject")
    expect(t3.type_defined(0x0E) == false && t3.type_defined(0x80) == false && t3.type_defined(0x04) == true && t3.type_writable(0x80) == false, "type_registry_policy")
    expect(t3.type_defined(0xF1) == false && t3.type_writable(0xF1) == true, "private_type_policy")
    var fpr = t3.frame_encode(0xF1, t3.fl_crc(), 0, 1, p1, empty)
    var (q0, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10) = t3.frame_view(fpr, 0)
    expect(q0 == 1 && q1 == 0xF1 && q9 == 1, "private_type_roundtrip")

    // ---- 7) 尾部互斥 / 保护帧结构 / 裸帧 ----
    expect(len(t3.frame_encode(t3.ft_message(), t3.fl_protected() | t3.fl_crc(), 0, 1, p1, empty)) == 0, "tail_conflict_encode_reject")
    var cfh = t3.header_encode(t3.ft_message(), t3.fl_protected() | t3.fl_crc(), 0, 1, len(p1))
    var (c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10) = t3.frame_view(cat2(cfh, p1), 0)
    expect(c0 == -1, "tail_conflict_decode_reject")
    expect(len(t3.frame_encode(t3.ft_message(), t3.fl_protected(), 0, 1, p1, empty)) == 0, "protected_encode_unwired")
    var pfh = t3.header_encode(t3.ft_message(), t3.fl_protected(), 1, 2, len(p1))
    var pfr = cat2(cat2(pfh, p1), pat(16))
    var (p0, p1v, p2, p3, p4, p5, p6, p7, p8, p9, p10) = t3.frame_view(pfr, 0)
    expect(p0 == 1 && p9 == -1 && p6 == len(p1) && p10 == len(pfr) && eqrange(pfr, p5, p6, p1), "protected_struct")
    var nk = t3.frame_encode(t3.ft_datagram(), 0, 0, 3, p1, empty)
    var (n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10) = t3.frame_view(nk, 0)
    expect(n0 == 1 && n9 == -1 && n10 == len(nk) && eqrange(nk, n5, n6, p1), "naked_frame")

    // ---- 8) CRC32C KAT + 篡改检测 ----
    expect(t3.crc32c_range(ascii("123456789"), 0, 9) == 0xE3069283, "crc_kat_digits")
    expect(t3.crc32c_range(bytes.fill(32, 0), 0, 32) == 0x8A9136AA, "crc_kat_zeros")
    expect(t3.crc32c_range(bytes.fill(32, 0xFF), 0, 32) == 0x62A8AB43, "crc_kat_ff")
    var inc = table_new_i64()
    var zi: i64 = 0
    while zi < 32 {
        table_push(inc, zi)
        zi = zi + 1
    }
    expect(t3.crc32c_range(inc, 0, 32) == 0x46DD794E, "crc_kat_inc")
    expect(t3.crc32c_range(inc, 0, 0) == 0, "crc_kat_empty")
    var tp1 = t3.frame_encode(t3.ft_message(), t3.fl_crc(), 1, 1, p1, empty)
    tp1[16] = (tp1[16] ^ 0xFF) & 0xFF
    var (h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10) = t3.frame_view(tp1, 0)
    expect(h0 == 1 && h9 == 0, "crc_tamper_payload")
    var tp2 = t3.frame_encode(t3.ft_message(), t3.fl_crc(), 1, 1, p1, empty)
    tp2[12] = (tp2[12] ^ 0xFF) & 0xFF
    var (w0, w1v, w2v, w3v, w4v, w5v, w6v, w7v, w8v, w9v, w10v) = t3.frame_view(tp2, 0)
    expect(w0 == 1 && w9v == 0, "crc_tamper_header")

    // ---- 9) 多帧行走：view 与 skip 成对一致 ----
    var s1 = t3.frame_encode(t3.ft_message(), t3.fl_crc(), 1, 1, pat(5), empty)
    var s2 = t3.frame_encode(t3.ft_message(), t3.fl_ext() | t3.fl_crc(), 1, 2, pat(7), t3.ext_tlv_u8(t3.tlv_priority(), 3))
    var s3 = t3.frame_encode(t3.ft_ping(), 0, 0, 3, empty, empty)
    var walkbuf = cat2(cat2(s1, s2), s3)
    var wa = t3.frame_skip(walkbuf, 0)
    var wb = t3.frame_skip(walkbuf, wa)
    var wc = t3.frame_skip(walkbuf, wb)
    expect(wa == len(s1) && wb == len(s1) + len(s2) && wc == len(walkbuf), "skip_chain")
    var (v1a, v1b, v1c, v1d, v1e, v1f, v1g, v1h, v1i, v1j, v1k) = t3.frame_view(walkbuf, 0)
    var (v2a, v2b, v2c, v2d, v2e, v2f, v2g, v2h, v2i, v2j, v2k) = t3.frame_view(walkbuf, v1k)
    var (v3a, v3b, v3c, v3d, v3e, v3f, v3g, v3h, v3i, v3j, v3k) = t3.frame_view(walkbuf, v2k)
    expect(v1k == wa && v2k == wb && v3k == wc, "walk_from_view")
    expect(v1i == -1 && v2i == 5 && v3i == -1, "walk_ext_len")
    expect(v1j == 1 && v2j == 1 && v3j == -1, "walk_iok")
    var (e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10) = t3.frame_view(walkbuf, wc)
    expect(e0 == 0, "walk_end_need_more")
    expect(t3.frame_skip(walkbuf, wc) == 0, "skip_end_need_more")

    // ---- 10) 截断 = 缓冲不足 ----
    var tr = t3.frame_encode(t3.ft_message(), t3.fl_ext() | t3.fl_crc(), 1, 1, pat(20), t3.ext_tlv_u64(t3.tlv_conn_id(), 1))
    var cuts = [0, 5, 15, 17, 19, 25, 0]
    cuts[6] = len(tr) - 1
    var cutok: bool = true
    var ci: i64 = 0
    while ci < 7 {
        var part = bytes.slice(tr, 0, cuts[ci])
        var (y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10) = t3.frame_view(part, 0)
        if y0 != 0 {
            cutok = false
        }
        if t3.frame_skip(part, 0) != 0 {
            cutok = false
        }
        ci = ci + 1
    }
    expect(cutok, "truncation_need_more")
    var (t0v, t1v, t2v, t3v, t4v, t5v, t6v, t7v, t8v, t9v, t10v) = t3.frame_view(tr, 0)
    expect(t0v == 1 && t9v == 1 && t10v == len(tr), "truncation_full_ok")

    // ---- 11) OFFSET 载荷前缀 ----
    var opr = t3.offset_prefix(0x00010000)
    var obody = cat2(opr, p1)
    var fof = t3.frame_encode(t3.ft_stream_data(), t3.fl_offset() | t3.fl_crc(), 1, 4, obody, empty)
    var (o0, o1, o2, o3, o4, o5, o6, o7, o8, o9, o10) = t3.frame_view(fof, 0)
    expect(o0 == 1 && o9 == 1 && o6 == len(obody) && bytes.from_u32_be(fof, o5) == 0x00010000 && eqrange(fof, o5 + 4, o6 - 4, p1), "offset_body")

    // ---- 12) 性能冒烟（量级记录，不作硬时限） ----
    // 12a) 小帧流：64 帧（EXT+CRC）构建 + O(1) 全行走
    var smbuf = table_new_i64()
    var sext = t3.ext_tlv_u8(t3.tlv_priority(), 3)
    var si: i64 = 0
    while si < 64 {
        var one = t3.frame_encode(t3.ft_message(), t3.fl_ext() | t3.fl_crc(), 1, si, pat(64), sext)
        smbuf = bytes.concat(smbuf, one)
        si = si + 1
    }
    var wk0 = time.now_ms()
    var cnt: i64 = 0
    var pvv = t3.frame_skip(smbuf, 0)
    while pvv > 0 {
        cnt = cnt + 1
        pvv = t3.frame_skip(smbuf, pvv)
    }
    var wk1 = time.now_ms()
    println("PERF-WALK: frames=" + to_string(cnt) + " ms=" + to_string(wk1 - wk0) + " bytes=" + to_string(len(smbuf)))
    expect(cnt == 64, "perf_walk_64")
    // 12b) 64KiB 上限帧：组装 + 视图（含 CRC 校验）
    var bigp = pat(65535)
    var bt0 = time.now_ms()
    var fbig = t3.frame_encode(t3.ft_stream_data(), t3.fl_crc(), 1, 0, bigp, empty)
    var bt1 = time.now_ms()
    var (b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10) = t3.frame_view(fbig, 0)
    var bt2 = time.now_ms()
    println("PERF-64K: encode_ms=" + to_string(bt1 - bt0) + " view_ms=" + to_string(bt2 - bt1))
    expect(b0 == 1 && b6 == 65535 && b9 == 1 && b10 == len(fbig), "perf_64k_roundtrip")

    // ---- 收尾 ----
    if g_rc == 0 {
        println("tinkv3:ALL:PASS")
    } else {
        println("tinkv3:ALL:FAIL")
    }
    return g_rc
}
