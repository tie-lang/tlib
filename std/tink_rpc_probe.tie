type tie<logic>
// std/tink_rpc_probe.tie —— tink v3 RPC 探针（设计文档 §4.5/§7/§4.7 验收）
// 覆盖：REQUEST（req_id/flags/service/method/payload）编解码与截断拒绝；RESPONSE
//   （status = 错误码）编解码；CANCEL/PUSH 编解码；错误码注册表（落区/分类/命名）；
//   请求登记状态机（登记/取消幂等/应答交付/取消后应答丢弃/超期扫描）；
//   线格式端到端（请求→应答、取消→晚到应答丢弃、超期→DEADLINE_EXCEEDED 应答）。
// 每项 PASS 打 `tinkv3p:<name>:OK`；失败 `tinkv3p:<name>:FAIL` 并把返回码置 1。
// 全部 PASS 打印 `tinkv3p:ALL:PASS` 且 exit 0。

import "./tink.tie" as t3
import "./bytes.tie" as bytes

var g_rc: i64 = 0

func expect(cond: bool, name: string) {
    if !cond {
        println("tinkv3p:" + name + ":FAIL")
        g_rc = 1
    } else {
        println("tinkv3p:" + name + ":OK")
    }
}

func main() -> i64 {
    var empty = table_new_i64()
    var crc = t3.fl_crc()

    // ---- 1) REQUEST 编解码 ----
    var rq = t3.request_frame(1, 20, 0x1122334455667788, 1, "svc.echo", "say", bytes.from_hex("beef"), crc)
    var (a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) = t3.frame_view(rq, 0)
    var (rq0, rq1, rq2, rq3, rq4, rq5, rq6) = t3.req_scan(rq, a5, a6)
    expect(a0 == 1 && a1 == t3.ft_request() && rq0 == 1 && rq1 == 0x1122334455667788 && rq2 == 1, "req_codec_fields")
    expect(rq3 == "svc.echo" && rq4 == "say" && bytes.to_hex(bytes.slice(rq, rq5, rq5 + rq6)) == "beef", "req_codec_payload")
    expect(t3.eo_allowed(rq2) == 1, "req_idempotent_flag")
    var badreq = bytes.concat(bytes.to_u64_be(1), bytes.from_hex("0110"))
    var bad2 = bytes.concat(badreq, bytes.from_hex("4142"))
    var (bq0, bq1, bq2, bq3, bq4, bq5, bq6) = t3.req_scan(bad2, 0, len(bad2))
    expect(bq0 == 0, "req_truncated_reject")

    // ---- 2) RESPONSE / CANCEL / PUSH 编解码 ----
    var rp = t3.response_frame(1, 21, 0x1122334455667788, t3.err_ok(), bytes.from_hex("0102"), crc)
    var (c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10) = t3.frame_view(rp, 0)
    var (rp0, rp1, rp2, rp3, rp4) = t3.resp_scan(rp, c5, c6)
    expect(c0 == 1 && c1 == t3.ft_response() && rp0 == 1 && rp1 == 0x1122334455667788 && rp2 == 0 && bytes.to_hex(bytes.slice(rp, rp3, rp3 + rp4)) == "0102", "resp_codec")
    var rd = t3.response_frame(1, 22, 7, t3.err_deadline_exceeded(), empty, crc)
    var (d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10) = t3.frame_view(rd, 0)
    var (rd0, rd1, rd2, rd3, rd4) = t3.resp_scan(rd, d5, d6)
    expect(rd0 == 1 && rd2 == 0x0105 && d1 == t3.ft_response(), "resp_deadline_status")
    var cf = t3.cancel_frame(1, 23, 0x1122334455667788, crc)
    var (e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10) = t3.frame_view(cf, 0)
    var (cc0, cc1) = t3.cancel_scan(cf, e5, e6)
    expect(e0 == 1 && e1 == t3.ft_cancel() && cc0 == 1 && cc1 == 0x1122334455667788, "cancel_codec")
    var qf = t3.push_frame(1, 24, 42, bytes.from_hex("abcd"), crc)
    var (f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10) = t3.frame_view(qf, 0)
    var (qq0, qq1, qq2, qq3) = t3.push_scan(qf, f5, f6)
    expect(f0 == 1 && f1 == t3.ft_push() && qq0 == 1 && qq1 == 42 && bytes.to_hex(bytes.slice(qf, qq2, qq2 + qq3)) == "abcd", "push_codec")

    // ---- 3) 错误码注册表 ----
    expect(t3.err_ok() == 0 && t3.err_frame_malformed() == 0x0101 && t3.err_timeout() == 0x0104 && t3.err_deadline_exceeded() == 0x0105, "err_transport_codes")
    expect(t3.err_no_route() == 0x0401 && t3.err_topic_invalid() == 0x0402 && t3.err_not_held() == 0x0501 && t3.err_target_unreachable() == 0x0601, "err_other_classes")
    expect(t3.err_class_of(t3.err_aead_tag_failed()) == 0x0300 && t3.err_class_of(t3.err_ok()) == 0, "err_class_of")
    expect(t3.err_name(t3.err_timeout()) == "TIMEOUT" && t3.err_name(t3.err_replay()) == "REPLAY" && t3.err_name(0x9999) == "UNKNOWN" && t3.err_name(0) == "OK", "err_name")

    // ---- 4) 请求登记状态机 ----
    var st = t3.rpc_new()
    expect(t3.rpc_track(st, 101, 1000) == 1 && t3.rpc_track(st, 101, 1000) == 0, "rpc_track")
    t3.rpc_track(st, 102, 2000)
    t3.rpc_track(st, 103, 0)
    expect(t3.rpc_state(st, 101) == 0 && t3.rpc_state(st, 103) == 0, "rpc_state_pending")
    expect(t3.rpc_cancel(st, 102) == 1 && t3.rpc_cancel(st, 102) == 0 && t3.rpc_state(st, 102) == 1, "rpc_cancel_idempotent")
    expect(t3.rpc_accept_response(st, 101) == 1 && t3.rpc_state(st, 101) == 2, "rpc_deliver")
    expect(t3.rpc_accept_response(st, 101) == 0, "rpc_late_drop")
    expect(t3.rpc_accept_response(st, 102) == 0, "rpc_cancelled_drop")
    expect(t3.rpc_accept_response(st, 999) == -1, "rpc_unknown")
    t3.rpc_track(st, 104, 1200)
    var ex1 = t3.rpc_expire(st, 1500)
    var ex2 = t3.rpc_expire(st, 1500)
    expect(len(ex1) == 1 && ex1[0] == 104 && t3.rpc_state(st, 104) == 2, "rpc_expire")
    expect(len(ex2) == 0, "rpc_expire_once")

    // ---- 5) 线格式端到端 ----
    var st2 = t3.rpc_new()
    var wq = t3.request_frame(3, 30, 555, 0, "svc.time", "now", empty, crc)
    var (g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10) = t3.frame_view(wq, 0)
    var (tq0, tq1, tq2, tq3, tq4, tq5, tq6) = t3.req_scan(wq, g5, g6)
    var trk = t3.rpc_track(st2, tq1, 0)
    var wr = t3.response_frame(3, 31, tq1, t3.err_ok(), empty, crc)
    var (h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10) = t3.frame_view(wr, 0)
    var (hr0, hr1, hr2, hr3, hr4) = t3.resp_scan(wr, h5, h6)
    expect(tq0 == 1 && tq3 == "svc.time" && trk == 1 && hr0 == 1 && hr1 == 555 && hr2 == 0, "e2e_request_response")
    expect(t3.rpc_accept_response(st2, hr1) == 1, "e2e_accept")
    var wq2 = t3.request_frame(3, 32, 556, 0, "svc.time", "now", empty, crc)
    var (m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10) = t3.frame_view(wq2, 0)
    var (zq0, zq1, zq2, zq3, zq4, zq5, zq6) = t3.req_scan(wq2, m5, m6)
    t3.rpc_track(st2, zq1, 0)
    var wc = t3.cancel_frame(3, 33, zq1, crc)
    var (j0, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10) = t3.frame_view(wc, 0)
    var (cj0, cj1) = t3.cancel_scan(wc, j5, j6)
    var cx = t3.rpc_cancel(st2, cj1)
    var wr2 = t3.response_frame(3, 34, zq1, t3.err_ok(), empty, crc)
    var (k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10) = t3.frame_view(wr2, 0)
    var (kr0, kr1, kr2, kr3, kr4) = t3.resp_scan(wr2, k5, k6)
    expect(cj0 == 1 && cx == 1 && kr1 == zq1 && t3.rpc_accept_response(st2, kr1) == 0, "e2e_cancel_late_drop")
    t3.rpc_track(st2, 557, 1200)
    var exd = t3.rpc_expire(st2, 1500)
    var wr3 = t3.response_frame(3, 35, exd[0], t3.err_deadline_exceeded(), empty, crc)
    var (l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10) = t3.frame_view(wr3, 0)
    var (lr0, lr1, lr2, lr3, lr4) = t3.resp_scan(wr3, l5, l6)
    expect(len(exd) == 1 && lr1 == 557 && lr2 == 0x0105, "e2e_deadline_response")

    // ---- 收尾 ----
    if g_rc == 0 {
        println("tinkv3p:ALL:PASS")
    } else {
        println("tinkv3p:ALL:FAIL")
    }
    return g_rc
}
