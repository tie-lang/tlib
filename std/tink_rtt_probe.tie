type tie<logic>
// std/tink_rtt_probe.tie —— tink v3 0-RTT 恢复探针（设计文档 §5.6/§6.5 验收）
// 覆盖：票据构造/扫描/HMAC 验真/篡改拒绝/TTL 上限；兑换流程（接受/有效期内重放拒绝/
//   过期拒绝/单次性烧毁持久/未烧毁过期转普通拒绝）；恢复密钥 KAT（Python 独立推演）；
//   early data 幂等位策略；RESUME 摘要（nstreams+各流 next_seq）往返；TICKET/RESUME
//   帧封装；端到端（签发→兑换→方向密钥一致→早期数据密文互通→重放拒绝）。
// 每项 PASS 打 `tinkv3t:<name>:OK`；失败 `tinkv3t:<name>:FAIL` 并把返回码置 1。
// 全部 PASS 打印 `tinkv3t:ALL:PASS` 且 exit 0。

import "./tink.tie" as t3
import "./bytes.tie" as bytes

var g_rc: i64 = 0

func expect(cond: bool, name: string) {
    if !cond {
        println("tinkv3t:" + name + ":FAIL")
        g_rc = 1
    } else {
        println("tinkv3t:" + name + ":OK")
    }
}

func main() -> i64 {
    var empty = table_new_i64()
    var crc = t3.fl_crc()
    var TK = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
    var ID1 = "01010101010101010101010101010101"
    var ID2 = "02020202020202020202020202020202"
    var ID3 = "03030303030303030303030303030303"
    var ID4 = "04040404040404040404040404040404"
    var ID5 = "05050505050505050505050505050505"
    var SEC = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    var DIG = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    var RESC = "11e7523f1fe2bddf4f9735da180e43f42e67caa12bbc5e528c51dd4c2bdc5074"
    var RESS = "80f86bc301f95c694fffd049ee2fe68861ed0959e826b601b657839df4f37f3e"
    var secb = bytes.from_hex(SEC)
    var digb = bytes.from_hex(DIG)

    // ---- 1) 票据构造 / 扫描 / 验真 ----
    var t1 = t3.tkt_build(TK, bytes.from_hex(ID1), 1000, 5000, 0, digb, secb)
    expect(len(t1) == 113, "tkt_len")
    var (sc0, sc1, sc2, sc3, sc4, sc5, sc6) = t3.tkt_scan(t1, 0, len(t1))
    expect(sc0 == 1 && sc1 == 1000 && sc2 == 6000 && sc3 == 0, "tkt_scan_fields")
    expect(bytes.to_hex(bytes.slice(t1, sc5, sc5 + 32)) == DIG && bytes.to_hex(bytes.slice(t1, sc6, sc6 + 32)) == SEC, "tkt_scan_bodies")
    expect(t3.tkt_verify(TK, t1, 0, len(t1)) == 1, "tkt_mac_ok")
    var t1b = bytes.slice(t1, 0, len(t1))
    t1b[40] = (t1b[40] ^ 0x01) & 0xFF
    expect(t3.tkt_verify(TK, t1b, 0, len(t1b)) == 0, "tkt_mac_tamper")
    var tbad = bytes.slice(t1, 0, len(t1))
    tbad[100] = (tbad[100] ^ 0x01) & 0xFF
    expect(t3.tkt_verify(TK, tbad, 0, len(tbad)) == 0, "tkt_mac_tamper_secret")
    expect(len(t3.tkt_build(TK, bytes.from_hex(ID1), 0, t3.tkt_max_ttl_ms() + 1, 0, digb, secb)) == 0, "tkt_ttl_cap")
    expect(len(t3.tkt_build(TK, bytes.from_hex(ID1), 0, t3.tkt_max_ttl_ms(), 0, digb, secb)) == 113, "tkt_ttl_max_ok")

    // ---- 2) 兑换流程 ----
    var store = t3.tkt_store_new()
    var (rv1, ro1) = t3.tkt_redeem(store, TK, t1, 0, len(t1), 1000)
    expect(rv1 == 1 && bytes.to_hex(bytes.slice(t1, ro1, ro1 + 32)) == SEC, "redeem_ok")
    var (rv2, ro2) = t3.tkt_redeem(store, TK, t1, 0, len(t1), 1500)
    expect(rv2 == -1, "redeem_replay_reject")
    var t2 = t3.tkt_build(TK, bytes.from_hex(ID2), 1000, 5000, 0, digb, secb)
    var (rv3, ro3) = t3.tkt_redeem(store, TK, t2, 0, len(t2), 1500)
    expect(rv3 == 1, "redeem_second_ticket")
    var t3t = t3.tkt_build(TK, bytes.from_hex(ID3), 0, 100, 0, digb, secb)
    var (rv4, ro4) = t3.tkt_redeem(store, TK, t3t, 0, len(t3t), 500)
    expect(rv4 == 0, "redeem_expired_reject")
    var t4 = t3.tkt_build(TK, bytes.from_hex(ID4), 0, 100, 1, digb, secb)
    var (rv5, ro5) = t3.tkt_redeem(store, TK, t4, 0, len(t4), 10)
    expect(rv5 == 1, "redeem_oneshot_first")
    var (rv6, ro6) = t3.tkt_redeem(store, TK, t4, 0, len(t4), 500)
    expect(rv6 == -1, "redeem_oneshot_burned_persists")
    var t5 = t3.tkt_build(TK, bytes.from_hex(ID5), 0, 100, 0, digb, secb)
    var (rv7, ro7) = t3.tkt_redeem(store, TK, t5, 0, len(t5), 10)
    var (rv8, ro8) = t3.tkt_redeem(store, TK, t5, 0, len(t5), 500)
    expect(rv7 == 1 && rv8 == 0, "redeem_nonburned_expiry")
    var (rv9, ro9) = t3.tkt_redeem(store, TK, t1b, 0, len(t1b), 2000)
    expect(rv9 == 0, "redeem_bad_mac_reject")

    // ---- 3) 恢复密钥 KAT + 方向分离 ----
    var (rk1, rk2) = t3.res_keys(SEC)
    expect(rk1 == RESC && rk2 == RESS && rk1 != rk2, "res_keys_kat")

    // ---- 4) early data 策略 ----
    expect(t3.eo_allowed(1) == 1 && t3.eo_allowed(0) == 0 && t3.eo_allowed(3) == 1, "eo_policy")

    // ---- 5) RESUME 摘要往返 ----
    var sids = table_new_i64()
    table_push(sids, 1)
    table_push(sids, 3)
    var seqs = table_new_i64()
    table_push(seqs, 10)
    table_push(seqs, 20)
    var rb = t3.resume_body(t1, sids, seqs)
    var (ru0, ru1, ru2, ru3, ru4) = t3.resume_scan(rb, 0, len(rb))
    expect(ru0 == 1 && ru2 == 113 && len(ru3) == 2 && ru3[0] == 1 && ru3[1] == 3 && ru4[1] == 20, "resume_roundtrip")
    expect(bytes.to_hex(bytes.slice(rb, ru1, ru1 + ru2)) == bytes.to_hex(t1), "resume_ticket_bytes")
    var rb0 = t3.resume_body(t1, empty, empty)
    var (rz0, rz1, rz2, rz3, rz4) = t3.resume_scan(rb0, 0, len(rb0))
    expect(rz0 == 1 && len(rz3) == 0 && rz2 == 113, "resume_empty_streams")

    // ---- 6) 帧封装 ----
    var tf = t3.ticket_frame(0, 1, t1, crc)
    var (f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10) = t3.frame_view(tf, 0)
    expect(f0 == 1 && f1 == t3.ft_ticket() && bytes.to_hex(bytes.slice(tf, f5, f5 + f6)) == bytes.to_hex(t1), "ticket_frame")
    var rf = t3.resume_frame(0, 2, rb, crc)
    var (g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10) = t3.frame_view(rf, 0)
    var (g2s0, g2s1, g2s2, g2s3, g2s4) = t3.resume_scan(rf, g5, g6)
    expect(g0 == 1 && g1 == t3.ft_resume() && g2s0 == 1 && len(g2s3) == 2, "resume_frame")

    // ---- 7) 端到端：签发 → 兑换 → 密钥一致 → 早期数据密文互通 → 重放拒绝 ----
    var store2 = t3.tkt_store_new()
    var tk_e = t3.tkt_build(TK, bytes.from_hex("99999999999999999999999999999999"), 100, 60000, 0, digb, secb)
    var (e1, e2) = t3.tkt_redeem(store2, TK, tk_e, 0, len(tk_e), 200)
    expect(e1 == 1 && bytes.to_hex(bytes.slice(tk_e, e2, e2 + 32)) == SEC, "e2e_redeem")
    var (c1, c2) = t3.res_keys(SEC)
    var ek = t3.hs_aead_key(c1)
    var efr = t3.frame_seal(t3.ft_stream_data(), 0, 3, 0, bytes.from_hex("a1b2c3d4e5f6"), empty, ek, t3.dir_ctos(), 0, 0)
    var (o1, p1, n1) = t3.frame_open(efr, 0, ek, t3.dir_ctos(), 0, 0)
    expect(o1 == 1 && bytes.to_hex(p1) == "a1b2c3d4e5f6", "e2e_early_data_seal")
    var (e3, e4) = t3.tkt_redeem(store2, TK, tk_e, 0, len(tk_e), 300)
    expect(e3 == -1, "e2e_replay_reject")

    // ---- 收尾 ----
    if g_rc == 0 {
        println("tinkv3t:ALL:PASS")
    } else {
        println("tinkv3t:ALL:FAIL")
    }
    return g_rc
}
