type tie<logic>
// std/tink_v3_hs_probe.tie —— tink v3 握手探针（设计文档 §6.2 验收）
// 覆盖：套件/哈希能力协商；HELLO/HELLO_ACK 体布局与扫描；固定种子完整握手
//   （transcript 双向签名/验签、防篡改、双端共享一致）；密钥表 5 秘密双端一致
//   + KAT 冻结（首次运行打印、固化后断言）；握手帧封装冒烟。
// 每项 PASS 打 `tinkv3h:<name>:OK`；失败 `tinkv3h:<name>:FAIL` 并把返回码置 1。
// 全部 PASS 打印 `tinkv3h:ALL:PASS` 且 exit 0。

import "./tink_v3.tie" as t3
import "./bytes.tie" as bytes

// KAT 冻结常量（2026-10-11 首轮实跑固化；空 = 未冻结不判）
var ks_cap: string = "a79f4e926e49cc7092346638f5ffc4c7f5355fbd5daceb6104c76e9e828a319e"
var ks_sap: string = "776d36fee3a6157244e47cf579d49f1945b9355c0a4342403f87fef69a3169ac"
var ks_exp: string = "066389864a93765d12a437a769d617352a9b897159c9acd02b03cc5179a67f71"

var g_rc: i64 = 0

func expect(cond: bool, name: string) {
    if !cond {
        println("tinkv3h:" + name + ":FAIL")
        g_rc = 1
    } else {
        println("tinkv3h:" + name + ":OK")
    }
}

func main() -> i64 {
    var empty = table_new_i64()
    var crc = t3.fl_crc()

    // ---- 1) 协商 ----
    expect(t3.hs_choose_suite(3, 2) == 1, "choose_suite_common")
    expect(t3.hs_choose_suite(5, 3) == 0, "choose_suite_low")
    expect(t3.hs_choose_suite(4, 2) == -1, "choose_suite_none")
    expect(t3.hs_choose_hash(7, 7) == 2, "choose_hash_blake3_first")
    expect(t3.hs_choose_hash(5, 5) == 1, "choose_hash_tsha2")
    expect(t3.hs_choose_hash(4, 6) == 4, "choose_hash_sha256_fallback")
    expect(t3.hs_choose_hash(1, 4) == 0, "choose_hash_none")

    // ---- 2) 固定种子完整握手 ----
    var c_eph_seed = "1111111111111111111111111111111111111111111111111111111111111111"
    var c_id_seed = "2222222222222222222222222222222222222222222222222222222222222222"
    var s_eph_seed = "3333333333333333333333333333333333333333333333333333333333333333"
    var s_id_seed = "4444444444444444444444444444444444444444444444444444444444444444"
    var rand_c_h = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    var rand_s_h = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    var c_eph_pub = t3.hs_eph_keygen(c_eph_seed)
    var c_id_pub = t3.hs_id_keygen(c_id_seed)
    var s_eph_pub = t3.hs_eph_keygen(s_eph_seed)
    var s_id_pub = t3.hs_id_keygen(s_id_seed)
    var rand_c = t3.hx32(rand_c_h)
    var rand_s = t3.hx32(rand_s_h)
    var feats: i64 = t3.feat_hash_blake3() | t3.feat_hash_sha256()
    var hello = t3.hello_body(3, 3, rand_c, t3.hx32(c_eph_pub), t3.hx32(c_id_pub), 3, feats, empty)
    expect(len(hello) == 108, "hello_len")
    var (hok, hinfo) = t3.hs_hello_scan(hello, 0, len(hello))
    expect(hok == 1 && hinfo[0] == 3 && hinfo[1] == 3 && hinfo[2] == 3 && hinfo[8] == 0, "hello_scan")
    expect(hello[hinfo[4]] == 0xAA && hello[hinfo[4] + 31] == 0xAA, "hello_scan_rand")
    var ack_p = t3.hello_ack_prefix(3, rand_s, t3.hx32(s_eph_pub), t3.hx32(s_id_pub), t3.suite_chacha20_poly1305_sha256(), feats)
    expect(len(ack_p) == 107, "ack_prefix_len")
    var ts = t3.hs_transcript_server(hello, ack_p)
    var sig_s = t3.hs_sign(s_id_seed, ts)
    expect(len(sig_s) == 128, "sig_hex_len")
    var ack = t3.hello_ack_body(ack_p, bytes.from_hex(sig_s))
    expect(len(ack) == 171, "ack_len")
    var (aok, ainfo) = t3.hs_ack_scan(ack, 0, len(ack))
    expect(aok == 1 && ainfo[0] == 3 && ainfo[1] == 0 && ainfo[6] == 107, "ack_scan")
    var tc = t3.hs_transcript_client(hello, ack)
    var sig_c = t3.hs_sign(c_id_seed, tc)
    expect(t3.hs_verify(s_id_pub, ts, sig_s) == 1, "verify_server_sig")
    expect(t3.hs_verify(c_id_pub, tc, sig_c) == 1, "verify_client_sig")
    expect(t3.hs_verify(s_id_pub, tc, sig_s) == 0, "verify_wrong_transcript")
    var ts_bad = bytes.slice(ts, 0, len(ts))
    ts_bad[100] = (ts_bad[100] ^ 0xFF) & 0xFF
    expect(t3.hs_verify(s_id_pub, ts_bad, sig_s) == 0, "verify_tampered")

    // ---- 3) 共享密钥与密钥表 ----
    var sc = t3.hs_shared(c_eph_seed, s_eph_pub)
    var ss = t3.hs_shared(s_eph_seed, c_eph_pub)
    expect(sc == ss && len(sc) == 64, "ecdh_agree")
    var (ch1, sh1, ca1, sa1, ex1) = t3.hs_keys(sc)
    var (ch2, sh2, ca2, sa2, ex2) = t3.hs_keys(ss)
    expect(ch1 == ch2 && sh1 == sh2 && ca1 == ca2 && sa1 == sa2 && ex1 == ex2, "keys_agree")
    expect(len(ch1) == 64 && len(ca1) == 64 && len(ex1) == 64, "keys_len")
    expect(ch1 != sh1 && ca1 != sa1 && ca1 != ch1, "keys_direction_separated")
    println("KAT-CAP:" + ca1)
    println("KAT-SAP:" + sa1)
    println("KAT-EXP:" + ex1)
    if len(ks_cap) > 0 {
        expect(ca1 == ks_cap && sa1 == ks_sap && ex1 == ks_exp, "kat_frozen")
    }

    // ---- 4) 握手帧封装冒烟 ----
    var hf = t3.frame_encode(t3.ft_hello(), crc, 0, 0, hello, empty)
    var (f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10) = t3.frame_view(hf, 0)
    var (s2ok, s2info) = t3.hs_hello_scan(hf, f5, f6)
    expect(f0 == 1 && f1 == t3.ft_hello() && f9 == 1 && s2ok == 1 && s2info[2] == 3, "hello_frame_smoke")

    // ---- 收尾 ----
    if g_rc == 0 {
        println("tinkv3h:ALL:PASS")
    } else {
        println("tinkv3h:ALL:FAIL")
    }
    return g_rc
}
